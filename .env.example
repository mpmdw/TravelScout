# ============================================================
#  TravelScout configuration
#  Copy this file to ".env.local" and fill in what you have.
#
#  SHADOW MODE: every feature works with realistic MOCK data when
#  its key is missing, so the app runs end-to-end with zero keys.
#  Drop in a real key and that feature switches to live data.
# ============================================================

# ---- Claude (Anthropic) ----------------------------------------------------
# Powers the live geopolitical "heat" + airline-cancellation web search.
# Get a key at https://console.anthropic.com/ . Leave blank to use mock intel.
ANTHROPIC_API_KEY=
# Model used for the web-search analysis (override if you like):
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Flight SEARCH (Amadeus Self-Service) ----------------------------------
# Powers live flight search. Create a free app at https://developers.amadeus.com
# to get a Client ID + Secret. The test host is free for development; switch the
# hostname to api.amadeus.com for production data. Leave blank to use mock flights.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com

# ---- Flight STATUS provider (wired in a later step) ------------------------
# e.g. AeroDataBox / FlightAware. Leave blank to use mock status.
FLIGHT_STATUS_API_KEY=

# ---- Access gate (username / password) -------------------------------------
# Set BOTH to require a login for the whole app — use this when you share it
# externally via a tunnel. Leave BOTH blank to disable the gate (local dev).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
